# Copia este archivo como .env (instalar.bat lo hace por ti) y rellena lo que quieras.
# Todo esto también se puede configurar desde el panel, en «Notificaciones».
# Lo que guardes en el panel tiene prioridad sobre estos valores.

# Puerto del panel: http://localhost:8787
PORT=8787
# 127.0.0.1 = solo desde este PC. Si algún día lo abres a la red, pon también DASHBOARD_PASSWORD.
HOST=127.0.0.1
# DASHBOARD_PASSWORD=

# Cada cuántos minutos se revisan los precios (mínimo 5).
CHECK_INTERVAL_MIN=60

# --- Telegram: crea un bot con @BotFather y saca tu chat ID con @userinfobot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord: Ajustes del canal → Integraciones → Webhooks → Copiar URL ---
DISCORD_WEBHOOK_URL=

# --- Correo (Gmail con «contraseña de aplicación»: myaccount.google.com/apppasswords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# --- Navegador para tiendas protegidas (Amazon, MediaMarkt, Fnac, El Corte Inglés, Eneba) ---
# Se usa el Edge de Windows en segundo plano. Para usar Chrome: BROWSER_CHANNEL=chrome
# BROWSER_CHANNEL=msedge,chrome
# Pon 1 para ver la ventana del navegador (útil si una tienda pide captcha: lo resuelves una vez).
# BROWSER_VISIBLE=0

# IA con Gemini (Fase 3): clave gratuita de https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo fijo. Vacío = el Flash estable más reciente.
GEMINI_MODEL=
